# WearerKey Environment Configuration (Template)
# Never commit actual secret keys to version control.

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# YouCam API Configuration (Server-Side Only)
# India-region endpoint: https://yce-api-01.makeupar.com
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=

# Cryptographic Keys Separation (Three distinct 64-character hexadecimal keys)
# 1. AES-256-GCM encryption key for provider identifiers at rest
PROVIDER_ID_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. Cookie & session signing secret
SESSION_COOKIE_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# 3. HMAC-SHA256 deletion receipt signing key
RECEIPT_SIGNING_KEY=11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff

# Database Connection (PostgreSQL or leave empty for embedded PGlite)
DATABASE_URL=

# Provider Operating Mode (LIVE_YOUCAM | RECORDED_LIVE_RESULT | DEMO_FIXTURE)
YOUCAM_PROVIDER_MODE=DEMO_FIXTURE
