# WearerKey Environment Configuration (Template)
# Never commit actual secret keys to version control.

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# YouCam API Configuration (Server-Side Only)
# India-region endpoint: https://yce-api-01.makeupar.com
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=

# Security & Encryption (AES-256-GCM for provider identifiers at rest)
# 64-character hexadecimal string (32 bytes)
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Connection (PostgreSQL or leave empty for embedded PGlite)
DATABASE_URL=

# Provider Operating Mode (LIVE_YOUCAM | RECORDED_LIVE_RESULT | DEMO_FIXTURE)
YOUCAM_PROVIDER_MODE=DEMO_FIXTURE
