{
  "name": "wearerkey",
  "version": "1.0.0",
  "private": true,
  "description": "WearerKey — Private Collaborative Virtual Try-On",
  "author": "Abhijeet Nardele",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @wearerkey/api dev",
    "dev:web": "pnpm --filter @wearerkey/web dev",
    "dev": "pnpm --parallel --filter @wearerkey/api --filter @wearerkey/web dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --noEmit",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
