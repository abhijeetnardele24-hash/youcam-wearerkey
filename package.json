{
  "name": "wearerkey",
  "version": "1.0.0",
  "private": true,
  "description": "WearerKey — Private Collaborative Virtual Try-On",
  "author": "Abhijeet Nardele",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @wearerkey/api dev",
    "dev:web": "pnpm --filter @wearerkey/web dev",
    "dev": "pnpm --parallel --filter @wearerkey/api --filter @wearerkey/web dev",
    "start": "pnpm --filter @wearerkey/api start",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --build",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.3",
    "vitest": "^2.1.8"
  }
}
